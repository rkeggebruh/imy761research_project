~ start
set State.is_in_dialog = true

if State.twiceLamp:
	Mari: Cappy, you know all about the [wave]Lampara[/wave].
	Mari: Me thinks its buy time
	set State.is_in_dialog = false
else:
	if State.lampFirstInteraction == false:
		set State.lampFirstInteraction = true
		Mari: Oh Cappy, that's a [wave]Lamp[/wave].
		Cappy: Oh cool.
		Mari: If you want light, you have to tell me what it is... in Spanish!
		set State.lampFillInLettersTimeOn = true
		
	if State.lampTurnOff == true:
		set State.is_in_dialog = true
		Mari: Cappy, to turn off the lamp, complete the word for me
		set State.lampFillInLettersTimeOff = true


=> END