~ start
set State.is_in_dialog = true

if State.twiceBench:
	Mari: Cappy, you know all about the [wave]Bench[/wave].
	Mari: Me thinks its buy time
	set State.is_in_dialog = false
else:
	if State.BenchFillInLettersTimeOnCorrect:
		Mari: Take another go at the bench Cappy...
		set State.BenchFillInLettersTimeOff = true
		
	else:
		Mari: This is the bench Cappy.
		Mari: Take a try at spelling it...
		set State.BenchFillInLettersTimeOn = true
		

set State.is_in_dialog = false
=> END